---
import BaseLayout from '../../layouts/BaseLayout.astro';
const formats = [
 {number:'01',title:'Productions',tag:'LIVE THEATER',text:'Artist Playground develops and presents theater productions. Individual show titles, descriptions, photos, and performance schedules will be listed here when details are available.',accent:'yellow'},
 {number:'02',title:'Educational Stage Works',tag:'SCHOOLS & STUDENTS',text:'Our educational theater work adapts Filipino literary works for student audiences. Visit Educational Productions for details about Ibong Adarna, Florante at Laura, Noli Me Tangere, and El Filibusterismo.',accent:'blue'},
 {number:'03',title:'Collaborations',tag:'PROJECT INQUIRIES',text:'We welcome inquiries from schools, organizations, venues, and creatives interested in working together on theater projects. Share your idea and relevant details through our Contact page.',accent:'yellow'},
];
---
<BaseLayout title="Theater Productions | Artist Playground" description="Information about Artist Playground theater productions, educational stage works, and collaborations.">
<section class="hero"><p class="eyebrow">ARTIST PLAYGROUND · ON STAGE</p><h1>Theater works<br/><span>and productions.</span></h1><p class="lead">Artist Playground develops and presents live theater, including educational adaptations of Filipino literature. This page shares production information as it becomes available.</p></section>
<section class="showcase"><div class="heading"><p class="eyebrow">WHAT WE CREATE</p><h2>Production information.</h2><p>Explore our theater work, educational stage adaptations, and opportunities for collaboration. We will publish specific production details when confirmed.</p></div><div class="cards">{formats.map((item)=><article class:list={['card',item.accent]}><div class="top"><span class="number">{item.number}</span><span class="tag">{item.tag}</span></div><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
<section class="cta"><p class="eyebrow">PRODUCTION DETAILS</p><h2>Specific show information will be posted here.</h2><p>We do not list unconfirmed titles, dates, or performance details. For production-related questions, please use the Contact page.</p></section>
</BaseLayout>
<style>
.hero{padding:clamp(4rem,9vw,8rem) 5vw 3rem;background:radial-gradient(ellipse at 78% 20%,#20202b 0%,var(--ap-black) 58%)}.eyebrow{color:var(--ap-blue);letter-spacing:.16em;font-size:var(--ap-size-eyebrow);font-weight:800}h1{font-family:var(--ap-font-display);font-size:var(--ap-size-hero);line-height:.95;letter-spacing:-.045em;color:var(--ap-yellow);margin:1.2rem 0}h1 span{color:var(--ap-text)}.lead{max-width:45rem;color:var(--ap-muted);font-size:var(--ap-size-body);line-height:1.7}.showcase{padding:clamp(3rem,6vw,5rem) 5vw}.heading{max-width:50rem;margin-bottom:2rem}.heading h2{font-family:var(--ap-font-display);font-size:var(--ap-size-section);line-height:1.05;letter-spacing:-.035em;margin:.6rem 0 1rem}.heading h2 span{color:var(--ap-yellow)}.heading>p:last-child{color:var(--ap-muted);line-height:1.7}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.card{min-height:280px;display:flex;flex-direction:column;padding:clamp(1.3rem,3vw,2rem);border:1px solid var(--ap-border);border-radius:1rem;background:#111}.card.yellow{border-top:3px solid var(--ap-yellow)}.card.blue{border-top:3px solid var(--ap-blue)}.top{display:flex;justify-content:space-between;align-items:center;gap:.8rem}.number{font-size:var(--ap-size-support);font-weight:900;color:var(--ap-muted);letter-spacing:.1em}.tag{font-size:var(--ap-size-micro);color:var(--ap-muted);letter-spacing:.08em;text-align:right}.card h3{font-family:var(--ap-font-display);font-size:var(--ap-size-card);line-height:1.1;color:var(--ap-text);margin:2rem 0 .75rem}.card p{color:var(--ap-muted);line-height:1.65;margin:0}.cta{padding:clamp(3rem,7vw,6rem) 5vw;background:var(--ap-blue);color:#071014}.cta .eyebrow{color:#071014}.cta h2{font-family:var(--ap-font-display);font-size:var(--ap-size-hero);line-height:1;margin:.75rem 0 1rem}.cta p:not(.eyebrow){max-width:42rem;line-height:1.7}@media(max-width:850px){.cards{grid-template-columns:1fr}.card{min-height:230px}}
</style>