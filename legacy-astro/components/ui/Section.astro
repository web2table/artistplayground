---
const { eyebrow, title } = Astro.props;
---
<section class="section">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  {title && <h2>{title}</h2>}
  <slot />
</section>
<style>
.section { padding:clamp(3rem,8vw,7rem) 5vw; }
.eyebrow { color:var(--ap-blue); text-transform:uppercase; letter-spacing:.15em; font-size:.75rem; }
h2 { font-family:var(--ap-font-display); font-size:clamp(2rem,6vw,4.5rem); margin:.4rem 0 1.5rem; }
</style>
