---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const works = [
 {number:'01',title:'Ibong Adarna',category:'Corrido · Filipino literature',description:'Step into a beloved adventure of quests, family, courage, and wonder—made vivid through theater.',accent:'blue'},
 {number:'02',title:'Florante at Laura',category:'Awit · Filipino literature',description:'Explore a classic story of love, loyalty, courage, and the challenges of a troubled kingdom.',accent:'gold'},
 {number:'03',title:'Noli Me Tangere',category:'Novel · José Rizal',description:'Bring Rizal’s landmark novel into the classroom through a live theatrical experience shaped around its characters and ideas.',accent:'blue'},
 {number:'04',title:'El Filibusterismo',category:'Novel · José Rizal',description:'Discover the themes, conflicts, and questions raised by Rizal’s sequel through performance and storytelling.',accent:'gold'},
];
---
<BaseLayout title="Educational Productions | Artist Playground" description="Educational theater productions inspired by Filipino literature for schools and student audiences.">
<section class="hero"><p class="eyebrow">ARTIST PLAYGROUND · FOR SCHOOLS</p><h1>Bring the pages<br/><span>to the stage.</span></h1><p class="lead">Make literature more vivid with educational theater. Familiar stories, memorable characters, and classroom learning—experienced live.</p></section>
<section class="catalog"><div class="section-heading"><p class="eyebrow">OUR LITERARY STAGE</p><h2>Stories students know.<br/><span>Performances they remember.</span></h2><p>Explore titles that can turn reading and discussion into a shared live experience.</p></div><div class="works">{works.map((work)=><article class:list={['work-card',work.accent]}><div class="card-top"><span class="number">{work.number}</span><span class="category">{work.category}</span></div><h3>{work.title}</h3><p>{work.description}</p></article>)}</div></section>
<section class="school-cta"><p class="eyebrow">FOR EDUCATORS & ORGANIZERS</p><h2>Planning a school performance?</h2><p>Tell us about your school, preferred title, audience, and schedule. Get in touch to discuss an educational production.</p></section>
</BaseLayout>
<style>
.hero{padding:clamp(4rem,9vw,8rem) 5vw 3rem;background:radial-gradient(ellipse at 80% 20%,#17212b 0%,var(--ap-black) 55%)}.eyebrow{color:var(--ap-blue);letter-spacing:.16em;font-size:.78rem;font-weight:800}h1{font-family:var(--ap-font-display);font-size:clamp(3.4rem,10vw,8rem);line-height:.95;letter-spacing:-.045em;color:var(--ap-yellow);margin:1.2rem 0}h1 span{color:var(--ap-text)}.lead{max-width:44rem;color:var(--ap-muted);font-size:clamp(1rem,2vw,1.25rem);line-height:1.7}.hero-cta{display:inline-flex;gap:.8rem;align-items:center;margin-top:1.4rem;padding:1rem 1.2rem;border:1px solid var(--ap-yellow);border-radius:.5rem;color:var(--ap-yellow);font-weight:800;text-decoration:none}.hero-cta:hover{background:var(--ap-yellow);color:var(--ap-black)}.catalog{padding:clamp(3rem,6vw,5rem) 5vw}.section-heading{max-width:50rem;margin-bottom:2rem}.section-heading h2{font-family:var(--ap-font-display);font-size:clamp(2rem,5.5vw,4.5rem);line-height:1.05;margin:.6rem 0 1rem;letter-spacing:-.035em}.section-heading h2 span{color:var(--ap-yellow)}.section-heading>p:last-child{color:var(--ap-muted);line-height:1.65}.works{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.work-card{min-height:290px;display:flex;flex-direction:column;padding:clamp(1.3rem,3vw,2rem);border:1px solid var(--ap-border);border-radius:1rem;background:#111}.work-card.gold{border-top:3px solid var(--ap-yellow)}.work-card.blue{border-top:3px solid var(--ap-blue)}.card-top{display:flex;justify-content:space-between;gap:1rem;align-items:center}.number{font-size:.8rem;font-weight:900;color:var(--ap-muted);letter-spacing:.1em}.category{color:var(--ap-muted);font-size:.72rem;text-align:right}.work-card h3{font-family:var(--ap-font-display);font-size:clamp(1.6rem,3vw,2.4rem);line-height:1.1;margin:2rem 0 .75rem;color:var(--ap-text)}.work-card p{color:var(--ap-muted);line-height:1.65;margin:0}.work-card a{margin-top:auto;padding-top:1.5rem;color:var(--ap-yellow);font-weight:800;text-decoration:none;width:max-content}.work-card.blue a{color:var(--ap-blue)}.school-cta{padding:clamp(3rem,7vw,6rem) 5vw;background:var(--ap-yellow);color:#090909}.school-cta .eyebrow{color:#171717}.school-cta h2{font-family:var(--ap-font-display);font-size:clamp(2.4rem,6vw,5rem);line-height:1;margin:.75rem 0 1rem}.school-cta p:not(.eyebrow){max-width:42rem;line-height:1.7}.school-cta a{display:inline-block;margin-top:1rem;padding:1rem 1.2rem;border:1px solid #111;color:#111;font-weight:900;text-decoration:none}.school-cta a:hover{background:#111;color:var(--ap-yellow)}@media(max-width:700px){.works{grid-template-columns:1fr}.work-card{min-height:240px}}
</style>