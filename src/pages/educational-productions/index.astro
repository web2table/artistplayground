---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ibongAdarnaPoster from '../../ibongadarna.jpg';
import florantePoster from '../../floranteatlaura.jpg';
import noliPoster from '../../noli.jpg';
import elFiliPoster from '../../elfili.jpg';
import juntoPoster from '../../juntoalpasig.jpg';
const works = [
 {number:'01',title:'Ibong Adarna',category:'Corrido · Filipino literature',description:'Follow Prince Juan and his brothers on their quest to capture the magical Adarna bird, through trials of courage, loyalty, betrayal, and forgiveness.',accent:'blue',poster:ibongAdarnaPoster},
 {number:'02',title:'Florante at Laura',category:'Awit · Filipino literature',description:'Set in the kingdom of Albania, the poem follows Florante amid betrayal and political turmoil, with themes of love, friendship, injustice, and patriotism.',accent:'gold',poster:florantePoster},
 {number:'03',title:'Noli Me Tangere',category:'Novel · José Rizal',description:'Crisostomo Ibarra returns to the Philippines and confronts corruption, abuse, and social injustice under colonial rule as he hopes to improve his community.',accent:'blue',poster:noliPoster},
 {number:'04',title:'El Filibusterismo',category:'Novel · José Rizal',description:'Years later, Simoun returns with a plan for revenge. The novel examines oppression, corruption, reform, and the consequences of seeking change through violence.',accent:'gold',poster:elFiliPoster},
 {number:'05',title:'Junto Al Pasig: The Rock, Ballet & Multimedia Zarzuela',category:'Zarzuela · José Rizal',description:'Reimagines José Rizal’s 1880 masterpiece as a fusion of rock music, classical ballet, multimedia art, and theater on a single stage.',accent:'blue',poster:juntoPoster},
];
---
<BaseLayout title="Educational Productions | Artist Playground" description="Explore educational theater adaptations of Filipino literary works for school audiences.">
<section class="hero"><p class="eyebrow">ARTIST PLAYGROUND · FOR SCHOOLS</p><h1>Bring the pages<br/><span>to the stage.</span></h1><p class="lead">Artist Playground presents stage adaptations of Filipino literary works. Read about each title to see its story, characters, and themes before discussing a school performance.</p></section>
<section class="catalog"><div class="section-heading"><p class="eyebrow">OUR LITERARY STAGE</p><h2>Stories students know.<br/><span>Performances they remember.</span></h2><p>Explore titles that can turn reading and discussion into a shared live experience.</p></div><div class="works">{works.map((work)=><article class:list={['work-card',work.accent]}><img class="poster" src={work.poster.src} alt={`${work.title} production poster`} loading="lazy"/><div class="card-content"><div class="card-top"><span class="number">{work.number}</span><span class="category">{work.category}</span></div><h3>{work.title}</h3><p>{work.description}</p></div></article>)}</div></section>
<section class="school-cta"><p class="eyebrow">FOR EDUCATORS & ORGANIZERS</p><h2>Planning a school performance?</h2><p>Tell us about your school, preferred title, audience, and schedule. Get in touch to discuss an educational production.</p></section>
</BaseLayout>
<style>
.hero{padding:clamp(4rem,9vw,8rem) 5vw 3rem;background:radial-gradient(ellipse at 80% 20%,#17212b 0%,var(--ap-black) 55%)}.eyebrow{color:var(--ap-blue);letter-spacing:.16em;font-size:var(--ap-size-eyebrow);font-weight:800}h1{font-family:var(--ap-font-display);font-size:var(--ap-size-hero);line-height:.95;letter-spacing:-.045em;color:var(--ap-yellow);margin:1.2rem 0}h1 span{color:var(--ap-text)}.lead{max-width:44rem;color:var(--ap-muted);font-size:var(--ap-size-body);line-height:1.7}.catalog{padding:clamp(3rem,6vw,5rem) 5vw}.section-heading{max-width:50rem;margin-bottom:2rem}.section-heading h2{font-family:var(--ap-font-display);font-size:var(--ap-size-section);line-height:1.05;margin:.6rem 0 1rem;letter-spacing:-.035em}.section-heading h2 span{color:var(--ap-yellow)}.section-heading>p:last-child{color:var(--ap-muted);line-height:1.65}.works{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.work-card{overflow:hidden;display:flex;flex-direction:column;border:1px solid var(--ap-border);border-radius:1rem;background:#111}.poster{width:100%;aspect-ratio:3/4;object-fit:cover;background:#080808}.work-card.gold{border-top:3px solid var(--ap-yellow)}.work-card.blue{border-top:3px solid var(--ap-blue)}.card-content{display:flex;flex-direction:column;padding:clamp(1.3rem,3vw,2rem)}.card-top{display:flex;justify-content:space-between;gap:1rem;align-items:center}.number{font-size:var(--ap-size-support);font-weight:900;color:var(--ap-muted);letter-spacing:.1em}.category{color:var(--ap-muted);font-size:var(--ap-size-micro);text-align:right}.work-card h3{font-family:var(--ap-font-display);font-size:var(--ap-size-card);line-height:1.1;margin:1.25rem 0 .75rem;color:var(--ap-text)}.work-card p{color:var(--ap-muted);line-height:1.65;margin:0}.school-cta{padding:clamp(3rem,7vw,6rem) 5vw;background:var(--ap-yellow);color:#090909}.school-cta .eyebrow{color:#171717}.school-cta h2{font-family:var(--ap-font-display);font-size:var(--ap-size-hero);line-height:1;margin:.75rem 0 1rem}.school-cta p:not(.eyebrow){max-width:42rem;line-height:1.7}@media(max-width:1000px){.works{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.works{grid-template-columns:1fr}.poster{aspect-ratio:3/4}}
</style>
