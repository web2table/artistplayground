---
import BaseLayout from '../../layouts/BaseLayout.astro';
const inquiryTypes = [
 {number:'01',title:'Educational Productions',tag:'FOR SCHOOLS',text:'Bring literature and stories to life for students through educational theater.',link:'Ask about a school show'},
 {number:'02',title:'Theater Productions',tag:'ON STAGE',text:'Talk with us about performances, stage projects, venues, and production opportunities.',link:'Discuss a production'},
 {number:'03',title:'Workshops',tag:'LEARN · EXPLORE · CREATE',text:'Explore workshops for your school, group, event, or creative community.',link:'Plan a workshop'},
 {number:'04',title:'Collaborations',tag:'LET’S CREATE',text:'Have an idea or partnership in mind? Let’s see what we can bring to life together.',link:'Start a collaboration'},
];
---
<BaseLayout title="Contact | Artist Playground" description="Get in touch with Artist Playground about educational theater, productions, workshops, and creative collaborations.">
<section class="hero"><p class="eyebrow">GET IN TOUCH · ARTIST PLAYGROUND</p><h1>Let's create<br/><span>something together.</span></h1><p class="lead">Have a school show in mind, want to talk about a production, or planning a workshop? We'd love to hear what you're imagining.</p><a class="hero-cta" href="mailto:artistplayground2025.marketing@gmail.com">EMAIL ARTIST PLAYGROUND ↗</a></section>
<section class="inquiries"><div class="heading"><p class="eyebrow">WHAT ARE YOU PLANNING?</p><h2>Start with an idea.<br/><span>We'll take it from there.</span></h2><p>These are the kinds of inquiries we welcome. Email us directly and include the relevant details so we can better understand your request.</p></div><div class="cards">{inquiryTypes.map(item=><article class="card"><div class="top"><span class="number">{item.number}</span><span class="tag">{item.tag}</span></div><h3>{item.title}</h3><p>{item.text}</p><a href={`mailto:artistplayground2025.marketing@gmail.com?subject=${encodeURIComponent(item.title)}`}>{item.link} ↗</a></article>)}</div></section>
<section class="cta"><p class="eyebrow">HAVE SOMETHING ELSE IN MIND?</p><h2>Send us your inquiry.</h2><p>Include your project or event, audience, preferred dates, venue (if available), and any questions. We will review your message and get back to you.</p><a href="mailto:artistplayground2025.marketing@gmail.com">EMAIL ARTIST PLAYGROUND ↗</a></section>
</BaseLayout>
<style>
.hero{padding:clamp(4rem,9vw,8rem) 5vw 3rem;background:radial-gradient(ellipse at 78% 20%,#20202b 0%,var(--ap-black) 58%)}.eyebrow{color:var(--ap-blue);letter-spacing:.16em;font-size:.78rem;font-weight:800}h1{font-family:var(--ap-font-display);font-size:clamp(3.4rem,10vw,8rem);line-height:.95;letter-spacing:-.045em;color:var(--ap-yellow);margin:1.2rem 0}h1 span{color:var(--ap-text)}.lead{max-width:45rem;color:var(--ap-muted);font-size:clamp(1rem,2vw,1.25rem);line-height:1.7}.hero-cta{display:inline-block;margin-top:1.4rem;padding:1rem 1.2rem;border:1px solid var(--ap-yellow);border-radius:.5rem;color:var(--ap-yellow);font-weight:800;text-decoration:none}.hero-cta:hover{background:var(--ap-yellow);color:var(--ap-black)}.inquiries{padding:clamp(3rem,6vw,5rem) 5vw}.heading{max-width:50rem;margin-bottom:2rem}.heading h2{font-family:var(--ap-font-display);font-size:clamp(2rem,5.5vw,4.5rem);line-height:1.05;letter-spacing:-.035em;margin:.6rem 0 1rem}.heading h2 span{color:var(--ap-yellow)}.heading>p:last-child{color:var(--ap-muted);line-height:1.7}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.card{min-height:260px;display:flex;flex-direction:column;padding:clamp(1.3rem,3vw,2rem);border:1px solid var(--ap-border);border-radius:1rem;background:#111}.top{display:flex;justify-content:space-between;align-items:center;gap:.8rem}.number{font-size:.8rem;font-weight:900;color:var(--ap-muted);letter-spacing:.1em}.tag{font-size:.7rem;color:var(--ap-muted);letter-spacing:.08em;text-align:right}.card h3{font-family:var(--ap-font-display);font-size:clamp(1.4rem,2.6vw,2.1rem);line-height:1.1;margin:2rem 0 .75rem;color:var(--ap-text)}.card p{color:var(--ap-muted);line-height:1.65;margin:0}.card a{margin-top:auto;padding-top:1.5rem;color:var(--ap-yellow);font-weight:800;text-decoration:none}.card a:hover{color:var(--ap-blue)}.cta{padding:clamp(3rem,7vw,6rem) 5vw;background:var(--ap-blue);color:#071014}.cta .eyebrow{color:#071014}.cta h2{font-family:var(--ap-font-display);font-size:clamp(2.4rem,6vw,5rem);line-height:1;margin:.75rem 0 1rem}.cta p:not(.eyebrow){max-width:42rem;line-height:1.7}.cta a{display:inline-block;margin-top:1rem;padding:1rem 1.2rem;border:1px solid #071014;color:#071014;font-weight:900;text-decoration:none}.cta a:hover{background:#071014;color:var(--ap-blue)}@media(max-width:850px){.cards{grid-template-columns:1fr}.card{min-height:230px}}
</style>