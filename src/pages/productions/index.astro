---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const formats = [
 {number:'01',title:'Original Productions',tag:'OUR STORIES',text:'Original theatrical work shaped by creative ideas, storytelling, and the energy of live performance.',accent:'yellow'},
 {number:'02',title:'Stage Experiences',tag:'LIVE PERFORMANCE',text:'Performances designed to bring audiences together through characters, stories, and moments that stay with them.',accent:'blue'},
 {number:'03',title:'Creative Collaborations',tag:'LET’S MAKE IT',text:'Collaborative opportunities with schools, organizations, venues, and fellow creatives to bring a production to life.',accent:'yellow'},
];
---
<BaseLayout title="Theater Productions | Artist Playground" description="Explore theater productions and live stage experiences from Artist Playground.">
<section class="hero"><p class="eyebrow">ARTIST PLAYGROUND · ON STAGE</p><h1>Stories made<br/><span>for the stage.</span></h1><p class="lead">Theater is where imagination meets a live audience. Discover the world of Artist Playground productions and the creative experiences we bring to the stage.</p></section>
<section class="showcase"><div class="heading"><p class="eyebrow">WHAT WE CREATE</p><h2>Made to be experienced<br/><span>live and together.</span></h2><p>Every production begins with a story and grows into a shared experience. Explore the kinds of stage work and creative opportunities at Artist Playground.</p></div><div class="cards">{formats.map((item)=><article class:list={['card',item.accent]}><div class="top"><span class="number">{item.number}</span><span class="tag">{item.tag}</span></div><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
<section class="cta"><p class="eyebrow">HAVE A PROJECT IN MIND?</p><h2>Let's bring your story to the stage.</h2><p>Reach out to discuss performances, collaborations, venues, or other theater-related inquiries.</p></section>
</BaseLayout>
<style>
.hero{padding:clamp(4rem,9vw,8rem) 5vw 3rem;background:radial-gradient(ellipse at 78% 20%,#20202b 0%,var(--ap-black) 58%)}.eyebrow{color:var(--ap-blue);letter-spacing:.16em;font-size:.78rem;font-weight:800}h1{font-family:var(--ap-font-display);font-size:clamp(3.4rem,10vw,8rem);line-height:.95;letter-spacing:-.045em;color:var(--ap-yellow);margin:1.2rem 0}h1 span{color:var(--ap-text)}.lead{max-width:45rem;color:var(--ap-muted);font-size:clamp(1rem,2vw,1.25rem);line-height:1.7}.hero-cta{display:inline-block;margin-top:1.4rem;padding:1rem 1.2rem;border:1px solid var(--ap-yellow);border-radius:.5rem;color:var(--ap-yellow);font-weight:800;text-decoration:none}.hero-cta:hover{background:var(--ap-yellow);color:var(--ap-black)}.showcase{padding:clamp(3rem,6vw,5rem) 5vw}.heading{max-width:50rem;margin-bottom:2rem}.heading h2{font-family:var(--ap-font-display);font-size:clamp(2rem,5.5vw,4.5rem);line-height:1.05;letter-spacing:-.035em;margin:.6rem 0 1rem}.heading h2 span{color:var(--ap-yellow)}.heading>p:last-child{color:var(--ap-muted);line-height:1.7}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.card{min-height:280px;display:flex;flex-direction:column;padding:clamp(1.3rem,3vw,2rem);border:1px solid var(--ap-border);border-radius:1rem;background:#111}.card.yellow{border-top:3px solid var(--ap-yellow)}.card.blue{border-top:3px solid var(--ap-blue)}.top{display:flex;justify-content:space-between;align-items:center;gap:.8rem}.number{font-size:.8rem;font-weight:900;color:var(--ap-muted);letter-spacing:.1em}.tag{font-size:.7rem;color:var(--ap-muted);letter-spacing:.08em;text-align:right}.card h3{font-family:var(--ap-font-display);font-size:clamp(1.4rem,2.6vw,2.1rem);line-height:1.1;color:var(--ap-text);margin:2rem 0 .75rem}.card p{color:var(--ap-muted);line-height:1.65;margin:0}.card a{margin-top:auto;padding-top:1.5rem;color:var(--ap-yellow);font-weight:800;text-decoration:none}.card.blue a{color:var(--ap-blue)}.cta{padding:clamp(3rem,7vw,6rem) 5vw;background:var(--ap-blue);color:#071014}.cta .eyebrow{color:#071014}.cta h2{font-family:var(--ap-font-display);font-size:clamp(2.4rem,6vw,5rem);line-height:1;margin:.75rem 0 1rem}.cta p:not(.eyebrow){max-width:42rem;line-height:1.7}.cta a{display:inline-block;margin-top:1rem;padding:1rem 1.2rem;border:1px solid #071014;color:#071014;font-weight:900;text-decoration:none}.cta a:hover{background:#071014;color:var(--ap-blue)}@media(max-width:850px){.cards{grid-template-columns:1fr}.card{min-height:230px}}
</style>