---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const categories=[{title:'Performances',text:'Stage productions and live performances from Artist Playground.'},{title:'Workshops',text:'Creative learning sessions and workshop opportunities.'},{title:'Announcements',text:'News, updates, and important Artist Playground notices.'}];
---
<BaseLayout title="Events | Artist Playground" description="Events, performances, workshops, and announcements from Artist Playground.">
<section class="hero"><p class="eyebrow">ARTIST PLAYGROUND · EVENTS</p><h1>Upcoming<br/><span>events.</span></h1><p class="lead">Confirmed performances, workshops, and public events will be listed here with their dates and details.</p></section>
<section class="updates"><div class="empty-state"><h3>No upcoming events announced.</h3><p>There are currently no upcoming events to share. This page will be updated when event details are confirmed.</p></div></section>
</BaseLayout>
<style>
.hero{padding:clamp(4rem,9vw,8rem) 5vw 3rem;background:radial-gradient(ellipse at 80% 20%,#22202c 0%,var(--ap-black) 58%)}.eyebrow{color:var(--ap-blue);letter-spacing:.16em;font-size:.78rem;font-weight:800}h1{font-family:var(--ap-font-display);font-size:clamp(3.4rem,10vw,8rem);line-height:.95;letter-spacing:-.045em;color:var(--ap-yellow);margin:1.2rem 0}h1 span{color:var(--ap-text)}.lead{max-width:44rem;color:var(--ap-muted);font-size:clamp(1rem,2vw,1.25rem);line-height:1.7}.hero-cta{display:inline-block;margin-top:1.4rem;padding:1rem 1.2rem;border:1px solid var(--ap-yellow);border-radius:.5rem;color:var(--ap-yellow);font-weight:800;text-decoration:none}.hero-cta:hover{background:var(--ap-yellow);color:var(--ap-black)}.updates{padding:clamp(3rem,6vw,5rem) 5vw}.intro{max-width:45rem;margin-bottom:2rem}.intro h2{font-family:var(--ap-font-display);font-size:clamp(2.2rem,5vw,4.3rem);margin:.6rem 0 1rem;line-height:1}.intro p:last-child{color:var(--ap-muted);line-height:1.7}.categories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.categories article{border:1px solid var(--ap-border);border-radius:1rem;background:#111;padding:1.5rem;min-height:200px}.num{color:var(--ap-muted);font-size:.8rem;font-weight:900}.categories h3{font-family:var(--ap-font-display);font-size:1.5rem;color:var(--ap-yellow);margin:1.3rem 0 .6rem}.categories p{color:var(--ap-muted);line-height:1.6}.empty-state{margin-top:2rem;padding:clamp(1.5rem,4vw,3rem);border:1px dashed var(--ap-border);border-radius:1rem;text-align:center}.empty-icon{font-size:1.8rem;color:var(--ap-blue)}.empty-state h3{font-family:var(--ap-font-display);font-size:1.5rem;margin:.8rem 0}.empty-state p{max-width:40rem;margin:0 auto;color:var(--ap-muted);line-height:1.65}.empty-state a{display:inline-block;margin-top:1.3rem;color:var(--ap-blue);font-weight:800;text-decoration:none}.cta{padding:clamp(3rem,7vw,6rem) 5vw;background:var(--ap-blue);color:#071014}.cta .eyebrow{color:#071014}.cta h2{font-family:var(--ap-font-display);font-size:clamp(2.4rem,6vw,5rem);line-height:1;margin:.75rem 0 1rem}.cta p:not(.eyebrow){max-width:42rem;line-height:1.7}.cta a{display:inline-block;margin-top:1rem;padding:1rem 1.2rem;border:1px solid #071014;color:#071014;font-weight:900;text-decoration:none}.cta a:hover{background:#071014;color:var(--ap-blue)}@media(max-width:800px){.categories{grid-template-columns:1fr}.categories article{min-height:160px}}
</style>