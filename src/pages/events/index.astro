---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="What's Happening | Artist Playground">
  <section class="page"><p class="eyebrow">UPDATES & EVENTS</p><h1>See what's happening.</h1><p>Upcoming shows, workshops, events, and announcements will be featured here.</p></section>
</BaseLayout>
<style>.page{padding:5rem 5vw;min-height:60vh}.eyebrow{color:var(--ap-blue);letter-spacing:.15em}h1{font-family:var(--ap-font-display);font-size:clamp(3rem,10vw,7rem);color:var(--ap-yellow)}</style>
