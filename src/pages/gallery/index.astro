---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Gallery | Artist Playground" description="Photos and moments from Artist Playground.">
  <section class="page">
    <p class="eyebrow">BEHIND THE CURTAIN</p>
    <h1>Gallery</h1>
    <p>Snapshots from our productions, workshops, events, and creative moments. Gallery highlights will be added here.</p>
    <a href="https://www.facebook.com/artplayg" target="_blank" rel="noopener noreferrer">Explore more on Facebook ↗</a>
  </section>
</BaseLayout>
<style>.page{padding:5rem 5vw;min-height:60vh}.eyebrow{color:var(--ap-blue);letter-spacing:.15em}h1{font-family:var(--ap-font-display);font-size:clamp(3rem,10vw,7rem);color:var(--ap-yellow)}a{color:var(--ap-blue)}</style>