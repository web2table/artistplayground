---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Gallery | Artist Playground" description="A glimpse into performances, workshops, rehearsals, and creative moments at Artist Playground.">
  <section class="gallery-page">
    <header class="intro">
      <p class="eyebrow">ARTIST PLAYGROUND · GALLERY</p>
      <h1>Gallery</h1>
      <p class="lead">Photos and videos from Artist Playground performances, rehearsals, workshops, and events will be collected here.</p>
    </header>
    <div class="empty-state">
      <h3>No gallery updates published.</h3>
      <p>There are currently no photos or videos to share. This page will be updated when gallery content is available.</p>
    </div>
  </section>
</BaseLayout>
<style>
.gallery-page{padding:clamp(3rem,7vw,6rem) 5vw;min-height:70vh}
.intro{width:100%;margin:0 0 4rem;text-align:left}
.eyebrow{color:var(--ap-blue);letter-spacing:.16em;font-size:.75rem;font-weight:700}
h1{font-family:var(--ap-font-display);font-size:clamp(3.2rem,10vw,7.5rem);line-height:.95;color:var(--ap-yellow);margin:1rem 0 1.5rem}
.lead{font-size:clamp(1.05rem,2vw,1.35rem);line-height:1.7;max-width:680px}
.empty-state{margin-top:2rem;padding:clamp(1.5rem,4vw,3rem);border:1px dashed var(--ap-border);border-radius:1rem;text-align:center}
.empty-state h3{font-family:var(--ap-font-display);font-size:1.5rem;margin:.8rem 0}
.empty-state p{max-width:40rem;margin:0 auto;color:var(--ap-muted);line-height:1.65}
@media(max-width:650px){.gallery-page{padding-inline:1.25rem}}
</style>