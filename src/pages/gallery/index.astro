---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Gallery | Artist Playground" description="A glimpse into performances, workshops, rehearsals, and creative moments at Artist Playground.">
  <section class="gallery-page">
    <header class="intro">
      <p class="eyebrow">ARTIST PLAYGROUND · GALLERY</p>
      <h1>Gallery</h1>
      <p class="lead">Photos and videos from Artist Playground performances, rehearsals, workshops, and events will be collected here.</p>
    </header>
    <div class="outro">
      <h2>Gallery updates coming soon.</h2>
      <p>There are currently no photos or videos published in this gallery.</p>
    </div>
  </section>
</BaseLayout>
<style>
.gallery-page{padding:clamp(3rem,7vw,6rem) 5vw;min-height:70vh}
.intro{width:100%;margin:0 0 4rem;text-align:left}
.eyebrow,.tag{color:var(--ap-blue);letter-spacing:.16em;font-size:.75rem;font-weight:700}
h1{font-family:var(--ap-font-display);font-size:clamp(3.2rem,10vw,7.5rem);line-height:.95;color:var(--ap-yellow);margin:1rem 0 1.5rem}
h1 span{color:var(--ap-text,inherit);opacity:.82}
.lead{font-size:clamp(1.05rem,2vw,1.35rem);line-height:1.7;max-width:680px}
.social-link{display:inline-block;margin-top:1.2rem;color:var(--ap-blue);font-weight:700;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:.3rem}
.gallery-grid{width:100%;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
.gallery-card{min-height:260px;border:1px solid rgba(128,128,128,.25);border-radius:1.25rem;padding:clamp(1.5rem,4vw,2.5rem);display:flex;flex-direction:column;justify-content:space-between;background:rgba(128,128,128,.045);transition:background .2s ease}

.number{font-size:.8rem;opacity:.55;letter-spacing:.12em}
.gallery-card h2{font-family:var(--ap-font-display);font-size:clamp(1.8rem,4vw,3rem);margin:.4rem 0}
.gallery-card p:not(.tag){opacity:.75;line-height:1.6;margin-bottom:0}
.tag{margin:0}
.outro{text-align:left;width:100%;margin:clamp(4rem,8vw,7rem) 0 1rem;padding-top:3rem;border-top:1px solid rgba(128,128,128,.25)}
.outro h2{font-family:var(--ap-font-display);font-size:clamp(2.5rem,6vw,4.5rem);color:var(--ap-yellow);line-height:1;margin:1rem 0}
.outro>p:not(.eyebrow){opacity:.75;line-height:1.7;max-width:44rem}
@media(max-width:650px){.gallery-grid{grid-template-columns:1fr}.gallery-card{min-height:220px}.gallery-page{padding-inline:1.25rem}}
</style>