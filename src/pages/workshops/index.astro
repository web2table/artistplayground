---
import BaseLayout from '../../layouts/BaseLayout.astro';
const workshopAreas = [
 {num:'01',title:'Performance & Stage',text:'Activities may include movement, voice, expression, stage presence, and exercises for working in front of an audience.',color:'yellow'},
 {num:'02',title:'Storytelling & Character',text:'Explore character motivations, storytelling, voice, and creative interpretation through guided activities and improvisation.',color:'blue'},
 {num:'03',title:'Creative Exploration',text:'Use theater games and creative exercises to experiment with ideas, collaborate, and express yourself through performance.',color:'yellow'},
];
---
<BaseLayout title="Workshops | Artist Playground" description="Workshop areas offered by Artist Playground, including performance, storytelling, character work, and creative theater activities.">
<section class="hero"><p class="eyebrow">LEARN · EXPLORE · CREATE</p><h1>Creative theater<br/><span>workshops.</span></h1><p class="lead">Artist Playground workshops explore theater and creative expression through guided activities in performance, storytelling, character, movement, voice, and collaboration.</p></section>
<section class="areas"><div class="intro"><p class="eyebrow">EXPLORE POSSIBILITIES</p><h2>Workshop areas.</h2><p>These are areas we can explore when planning a workshop. Activities and session structure can be discussed based on the participants, group size, age range, and objectives.</p></div><div class="tiles">{workshopAreas.map(area=><article class:list={['tile',area.color]}><span class="num">{area.num}</span><h3>{area.title}</h3><p>{area.text}</p></article>)}</div></section>
<section class="cta"><p class="eyebrow">SCHOOLS · GROUPS · ORGANIZERS</p><h2>Planning a workshop?</h2><p>When you inquire, include your group or organization, participant age range, approximate group size, preferred date, venue, and learning goals so we can discuss an appropriate session.</p></section>
</BaseLayout>
<style>
.hero{padding:clamp(4rem,9vw,8rem) 5vw 3rem;background:radial-gradient(ellipse at 80% 18%,#172b26 0%,var(--ap-black) 57%)}.eyebrow{color:var(--ap-blue);letter-spacing:.16em;font-size:.78rem;font-weight:800}h1{font-family:var(--ap-font-display);font-size:clamp(3.5rem,10vw,8rem);line-height:.94;letter-spacing:-.045em;color:var(--ap-yellow);margin:1.2rem 0}h1 span{color:var(--ap-text)}.lead{max-width:44rem;color:var(--ap-muted);font-size:clamp(1rem,2vw,1.25rem);line-height:1.7}.areas{padding:clamp(3rem,6vw,5rem) 5vw}.intro{max-width:50rem;margin-bottom:2rem}.intro h2{font-family:var(--ap-font-display);font-size:clamp(2rem,5.5vw,4.5rem);line-height:1.05;letter-spacing:-.035em;margin:.6rem 0 1rem}.intro h2 span{color:var(--ap-yellow)}.intro>p:last-child{color:var(--ap-muted);line-height:1.7}.tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.tile{min-height:270px;display:flex;flex-direction:column;padding:clamp(1.3rem,3vw,2rem);border:1px solid var(--ap-border);border-radius:1rem;background:#111}.tile.yellow{border-top:3px solid var(--ap-yellow)}.tile.blue{border-top:3px solid var(--ap-blue)}.num{font-size:.8rem;font-weight:900;color:var(--ap-muted);letter-spacing:.1em}.tile h3{font-family:var(--ap-font-display);font-size:clamp(1.4rem,2.5vw,2rem);line-height:1.1;margin:1.7rem 0 .75rem;color:var(--ap-text)}.tile p{color:var(--ap-muted);line-height:1.65;margin:0}.cta{padding:clamp(3rem,7vw,6rem) 5vw;background:var(--ap-yellow);color:#090909}.cta .eyebrow{color:#161616}.cta h2{font-family:var(--ap-font-display);font-size:clamp(2.4rem,6vw,5rem);line-height:1;margin:.75rem 0 1rem}.cta p:not(.eyebrow){max-width:42rem;line-height:1.7}@media(max-width:850px){.tiles{grid-template-columns:1fr}.tile{min-height:230px}}
</style>