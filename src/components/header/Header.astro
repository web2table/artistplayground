---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;
const activeFor = (path) => currentPath === path || (path !== base && currentPath.startsWith(path));
const links = [
  { label: 'Home', href: base },
  { label: 'About', href: `${base}about/` },
  { label: 'Educational', href: `${base}educational-productions/` },
  { label: 'Theater', href: `${base}productions/` },
  { label: 'Workshops', href: `${base}workshops/` },
  { label: 'Events', href: `${base}events/` },
  { label: 'Gallery', href: `${base}gallery/` },
  { label: 'Contact', href: `${base}contact/` },
];
---
<header class="site-header">
  <a class="brand" href={base} aria-label="Artist Playground home">
    <img class="brand-logo" src="https://raw.githubusercontent.com/web2table/artistplayground/main/ap.jpg" alt="Artist Playground logo" />
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">
    <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="menu-label">Menu</span>
  </button>
  <nav id="main-navigation" aria-label="Main navigation">
    {links.map((link) => (
      <a href={link.href} class:list={{ 'is-active': activeFor(link.href) }} aria-current={activeFor(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
</header>
<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.menu-toggle');
  const nav = header?.querySelector('#main-navigation');
  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    header?.classList.remove('menu-open');
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('menu-open', open);
  });
  nav?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement) closeMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
  document.addEventListener('click', (event) => {
    if (header && !header.contains(event.target)) closeMenu();
  });
</script>
<style>
.site-header { display:flex; align-items:center; justify-content:space-between; gap:2rem; padding:1rem 5vw; border-bottom:1px solid var(--ap-border); background:var(--ap-black); position:relative; z-index:20; }
.brand { display:flex; align-items:center; text-decoration:none; flex-shrink:0; }
.brand-logo { width:auto; height:3.5rem; max-width:220px; object-fit:contain; }
nav { display:flex; align-items:center; flex-wrap:wrap; justify-content:flex-end; gap:.4rem; }
nav a { text-decoration:none; font-size:.8rem; padding:.6rem .75rem; color:var(--ap-text); border:1px solid transparent; border-radius:.45rem; transition:color .15s,background .15s,border-color .15s; }
nav a:hover, nav a:focus-visible { color:var(--ap-yellow); border-color:var(--ap-border); outline:none; }
nav a.is-active { color:#000; border-color:var(--ap-yellow); background:var(--ap-yellow); font-weight:800; box-shadow:0 0 0 1px var(--ap-yellow); }
.menu-toggle { display:none; align-items:center; justify-content:center; gap:.65rem; border:1px solid var(--ap-border); background:#111; color:var(--ap-text); padding:.65rem .8rem; border-radius:.5rem; cursor:pointer; }
.menu-icon { display:flex; width:1.1rem; flex-direction:column; gap:4px; }
.menu-icon span { display:block; width:100%; height:2px; background:currentColor; transition:transform .2s,opacity .2s; }
.menu-label { font-size:.85rem; font-weight:700; }
@media(max-width:850px) {
  .site-header { flex-direction:row; align-items:center; gap:1rem; padding:1rem 5vw; }
  .menu-toggle { display:flex; }
  nav { display:none; position:absolute; left:0; right:0; top:100%; padding:1rem 5vw 1.25rem; background:var(--ap-black); border-bottom:1px solid var(--ap-border); flex-direction:column; align-items:stretch; gap:.3rem; box-shadow:0 16px 28px rgba(0,0,0,.35); }
  .menu-open nav { display:flex; }
  nav a { display:block; width:100%; padding:.8rem 1rem; font-size:.9rem; border-radius:.4rem; }
  nav a:hover,nav a:focus-visible { background:#151515; }
  nav a.is-active { background:var(--ap-yellow); color:#000; border-color:var(--ap-yellow); font-weight:800; }
  .menu-open .menu-icon span:nth-child(1) { transform:translateY(6px) rotate(45deg); }
  .menu-open .menu-icon span:nth-child(2) { opacity:0; }
  .menu-open .menu-icon span:nth-child(3) { transform:translateY(-6px) rotate(-45deg); }
}
@media(max-width:480px) { .site-header { padding:1rem 4vw; } .brand-logo { height:3rem; max-width:190px; } nav { padding-left:4vw; padding-right:4vw; } }
</style>