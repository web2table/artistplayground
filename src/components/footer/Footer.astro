---
import { SITE } from '../../core/config.js';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<footer class="site-footer">
  <div class="footer-main">
    <div class="brand-block">
      <a class="brand" href={base} aria-label="Artist Playground home">
        <img src="https://raw.githubusercontent.com/web2table/artistplayground/main/ap.jpg" alt="Artist Playground logo" />
      </a>
      <p>Where artists play, and audiences discover.</p>
      <div class="social-links" aria-label="Artist Playground social media">
        <a class="social" href="https://www.tiktok.com/@artist.playground?lang=en" target="_blank" rel="noopener noreferrer" aria-label="Artist Playground on TikTok"><svg class="tiktok-mark" viewBox="0 0 100 100" aria-hidden="true"><path fill="#25F4EE" transform="translate(-4 -2)" d="M62 10v46a18 18 0 1 1-16-18v16a8 8 0 1 0 8 8V10h14c1 12 8 19 20 20v15c-11 0-20-5-26-13z"/><path fill="#FE2C55" transform="translate(4 2)" d="M62 10v46a18 18 0 1 1-16-18v16a8 8 0 1 0 8 8V10h14c1 12 8 19 20 20v15c-11 0-20-5-26-13z"/><path fill="#fff" d="M62 10v46a18 18 0 1 1-16-18v16a8 8 0 1 0 8 8V10h14c1 12 8 19 20 20v15c-11 0-20-5-26-13z"/></svg></a>
        <a class="social" href="https://www.instagram.com/art.playg/" target="_blank" rel="noopener noreferrer" aria-label="Artist Playground on Instagram"><svg class="instagram-mark" viewBox="0 0 100 100" aria-hidden="true"><defs><linearGradient id="ig-gradient" x1="0" y1="1" x2="1" y2="0"><stop offset="0%" stop-color="#FFD600"/><stop offset="35%" stop-color="#FF7A00"/><stop offset="65%" stop-color="#FF0169"/><stop offset="100%" stop-color="#D300C5"/></linearGradient></defs><rect x="5" y="5" width="90" height="90" rx="25" fill="url(#ig-gradient)"/><rect x="23" y="23" width="54" height="54" rx="17" fill="none" stroke="#fff" stroke-width="8"/><circle cx="50" cy="50" r="14" fill="none" stroke="#fff" stroke-width="8"/><circle cx="69" cy="31" r="5" fill="#fff"/></svg></a>
        <a class="social" href="https://www.facebook.com/artplayg" target="_blank" rel="noopener noreferrer" aria-label="Artist Playground on Facebook"><svg class="facebook-mark" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="50" fill="#0866FF"/><path fill="#fff" d="M57 84V55h10l2-13H57v-8c0-4 2-6 7-6h6V16c-3-.5-7-1-11-1-13 0-22 8-22 23v4H27v13h10v29z"/></svg></a>
      </div>
    </div>
    <div class="footer-links">
      <p class="links-label">EXPLORE</p>
      <nav aria-label="Footer navigation">
        <a href={base}>Home</a>
        <a href={`${base}about/`}>About</a>
        <a href={`${base}educational-productions/`}>Educational Theater</a>
        <a href={`${base}productions/`}>Theater Productions</a>
        <a href={`${base}workshops/`}>Workshops</a>
        <a href={`${base}events/`}>Events</a>
        <a href={`${base}gallery/`}>Gallery</a>
        <a href={`${base}contact/`}>Contact</a>
      </nav>
    </div>
  </div>
  <div class="footer-bottom">
    <small>© {new Date().getFullYear()} Artist Playground. All rights reserved.</small>
    <small>Performance · Education · Creativity</small>
  </div>
</footer>
<style>
.site-footer { margin-top:clamp(2rem,4vw,4rem); border-top:1px solid var(--ap-border); padding:clamp(1.5rem,3vw,2.25rem) 5vw .75rem; color:var(--ap-muted); }
.footer-main { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,1fr); gap:clamp(1.5rem,3vw,3rem); align-items:start; }
.brand-block { display:flex; flex-direction:column; align-items:flex-start; gap:.75rem; }
.brand { display:inline-flex; align-items:center; text-decoration:none; }
.brand img { display:block; width:auto; height:3.25rem; max-width:200px; object-fit:contain; }
.brand-block p { margin:0; color:var(--ap-muted); line-height:1.6; }
.social-links { display:flex; flex-wrap:wrap; gap:.8rem; align-items:center; }
.social { display:inline-flex; align-items:center; justify-content:center; width:2.25rem; height:2.25rem; border-radius:.4rem; text-decoration:none; color:#fff; }
.social img,.social svg { width:1.75rem; height:1.75rem; display:block; object-fit:contain; }
.social svg.tiktok-mark { width:2.8rem; height:2.8rem; }
.social img[alt="TikTok"] { filter:invert(1); }
.social:hover,.social:focus-visible { transform:translateY(-2px); outline:2px solid var(--ap-blue); outline-offset:3px; }
.links-label { color:var(--ap-blue); font-size:.7rem; font-weight:800; letter-spacing:.16em; margin:0 0 .75rem; }
.footer-links nav { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.55rem 1.25rem; }
.footer-links nav a { text-decoration:none; color:var(--ap-text); font-size:.85rem; width:max-content; max-width:100%; }
.footer-links nav a:hover,.footer-links nav a:focus-visible { color:var(--ap-yellow); }
.footer-bottom { margin-top:1.5rem; padding-top:.75rem; border-top:1px solid var(--ap-border); display:flex; justify-content:space-between; flex-wrap:wrap; gap:.75rem; font-size:.75rem; }
@media(max-width:700px){ .footer-main{grid-template-columns:1fr;gap:1.5rem} .footer-links nav{grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem 1rem} .footer-bottom{flex-direction:column;align-items:flex-start} }
@media(max-width:380px){ .footer-links nav{grid-template-columns:1fr} }
</style>